        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sơ đồ lớp nghiệp vụ Cafenix\nskinparam classBackgroundColor #74C5E7\nskinparam classBorderColor #1F2937\nskinparam shadowing false\nhide empty members\n\nclass Cafe {\n  +id: string\n  +name: string\n  +createBranch()\n}\nclass User {\n  +id: string\n  +username: string\n  +fullName: string\n  +role: string\n  +status: string\n  +login()\n  +logout()\n}\nclass Branch {\n  +id: string\n  +cafeId: string\n  +code: string\n  +name: string\n  +address: string\n  +openTime: string\n  +closeTime: string\n  +status: number\n  +changeStatus()\n}\nclass Area {\n  +id: string\n  +branchId: string\n  +code: string\n  +name: string\n  +isBooking: boolean\n  +status: number\n  +create()\n  +update()\n  +remove()\n}\nclass Room {\n  +id: string\n  +areaId: string\n  +name: string\n  +status: number\n  +create()\n  +update()\n  +remove()\n}\nclass CafeTable {\n  +id: string\n  +roomId: string\n  +name: string\n  +description: string\n  +status: number\n  +customerCapacity: number\n  +create()\n  +update()\n  +remove()\n}\nclass TableSession {\n  +id: string\n  +branchId: string\n  +areaId: string\n  +roomId: string\n  +tableId: string\n  +customerCount: number\n  +status: TableSessionStatus\n  +startedAt: datetime\n  +endedAt: datetime\n  +start()\n  +close()\n}\nclass MenuCategory {\n  +id: string\n  +name: string\n  +sortOrder: number\n}\nclass MenuProduct {\n  +id: string\n  +branchId: string\n  +categoryId: string\n  +name: string\n  +description: string\n  +imageUrl: string\n  +price: decimal\n  +status: string\n  +save()\n  +remove()\n}\nclass TableOrder {\n  +id: string\n  +tableSessionId: string\n  +orderNumber: string\n  +status: string\n  +subtotal: decimal\n  +total: decimal\n  +create()\n  +updateStatus()\n}\nclass OrderItem {\n  +id: string\n  +orderId: string\n  +productId: string\n  +productNameSnapshot: string\n  +unitPriceSnapshot: decimal\n  +quantity: number\n  +total: decimal\n}\nclass GameCatalog {\n  +id: string\n  +name: string\n  +minPlayers: number\n  +maxPlayers: number\n  +minPlayTime: number\n  +maxPlayTime: number\n  +difficulty: number\n  +imageUrl: string\n  +description: string\n  +search()\n  +getDetail()\n}\nclass GameInventory {\n  +id: string\n  +branchId: string\n  +gameId: string\n  +quantity: number\n  +availableQuantity: number\n  +inUseQuantity: number\n  +shelfCode: string\n  +addStock()\n  +updateStock()\n}\nclass GameSession {\n  +id: string\n  +tableSessionId: string\n  +gameId: string\n  +startedAt: datetime\n  +endedAt: datetime\n  +status: string\n  +start()\n  +returnGame()\n}\nclass Invoice {\n  +id: string\n  +tableSessionId: string\n  +orderAmount: decimal\n  +gameMinutes: number\n  +gameFee: decimal\n  +grandTotal: decimal\n  +paidAmount: decimal\n  +status: string\n  +calculate()\n  +create()\n}\nclass Payment {\n  +id: string\n  +invoiceId: string\n  +method: string\n  +amount: decimal\n  +transactionReference: string\n  +paidAt: datetime\n  +confirm()\n}\n\nCafe \&quot;1\&quot; o-- \&quot;1..*\&quot; Branch\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Branch : được phân quyền\nBranch \&quot;1\&quot; o-- \&quot;0..*\&quot; Area\nArea \&quot;1\&quot; o-- \&quot;0..*\&quot; Room\nRoom \&quot;1\&quot; o-- \&quot;1..*\&quot; CafeTable\nCafeTable \&quot;1\&quot; -- \&quot;0..*\&quot; TableSession\nBranch \&quot;1\&quot; -- \&quot;0..*\&quot; TableSession\nTableSession \&quot;1\&quot; o-- \&quot;0..*\&quot; TableOrder\nTableOrder \&quot;1\&quot; o-- \&quot;1..*\&quot; OrderItem\nMenuCategory \&quot;1\&quot; -- \&quot;0..*\&quot; MenuProduct\nBranch \&quot;1\&quot; -- \&quot;0..*\&quot; MenuProduct\nBranch \&quot;1\&quot; -- \&quot;0..*\&quot; GameInventory\nGameCatalog \&quot;1\&quot; -- \&quot;0..*\&quot; GameInventory\nTableSession \&quot;1\&quot; o-- \&quot;0..*\&quot; GameSession\nGameCatalog \&quot;1\&quot; -- \&quot;0..*\&quot; GameSession\nTableSession \&quot;1\&quot; -- \&quot;0..1\&quot; Invoice\nInvoice \&quot;1\&quot; o-- \&quot;0..*\&quot; Payment\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="MhmSkAPRQK-47AquMJ30-3">
