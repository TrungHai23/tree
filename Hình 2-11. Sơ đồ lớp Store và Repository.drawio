        <UserObject label="Sơ đồ lớp nghiệp vụ Cafenix" plantUmlId="cltitle_2" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="Sơ đồ lớp nghiệp vụ Cafenix" id="MhmSkAPRQK-47AquMJ30-4">
