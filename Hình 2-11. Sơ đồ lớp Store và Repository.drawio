        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sơ đồ lớp Store và Repository\nskinparam classBackgroundColor #74C5E7\nskinparam classBorderColor #1F2937\nskinparam shadowing false\n\nclass AuthStore {\n  +user: User\n  +login(payload)\n  +logout()\n  +loadUser()\n  +changeBranch(branchId)\n}\nclass BranchStore {\n  +branches: Branch[]\n  +fetchBranches()\n  +create(payload)\n  +update(payload)\n  +remove(id)\n}\nclass SpaceStore {\n  +fetchAreas(branchId)\n  +fetchRooms(areaId)\n  +fetchTables(roomId)\n}\nclass CommerceStore {\n  +session: TableSession\n  +createSession(payload)\n  +loadRoomStates(roomId)\n  +createOrder(items)\n  +createInvoice()\n  +payInvoice()\n  +closeSession()\n}\nclass GameStore {\n  +fetchGames(query)\n  +fetchDetail(id)\n  +fetchCategories()\n}\nclass GameOperationsStore {\n  +inventory: GameInventory[]\n  +load(branchId)\n  +addInventory(payload)\n  +orderGame(sessionId, inventoryId)\n  +returnGame(target)\n}\nclass DrinkManagementStore {\n  +drinks: MenuProduct[]\n  +load(branchId, filters)\n  +save(payload)\n  +uploadImage(file)\n  +remove(drinkId)\n}\nclass InvoiceManagementStore {\n  +invoices: Invoice[]\n  +load(branchId, filters)\n  +loadDetail(invoiceId)\n  +pay(invoiceId, amount, method)\n}\ninterface CommerceRepository {\n  +createSession()\n  +createOrder()\n  +getInvoicePreview()\n  +createPayment()\n}\ninterface GameRepository {\n  +getGames(query)\n  +getGameDetail(id)\n}\n\nAuthStore --&gt; BranchStore : branch context\nBranchStore ..&gt; Cafe : BranchRepository\nSpaceStore ..&gt; Area : AreaRepository\nSpaceStore ..&gt; Room : RoomRepository\nSpaceStore ..&gt; CafeTable : TableRepository\nCommerceStore ..&gt; CommerceRepository\nGameStore ..&gt; GameRepository\nGameOperationsStore ..&gt; CommerceRepository\nDrinkManagementStore ..&gt; CommerceRepository\nInvoiceManagementStore ..&gt; CommerceRepository\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="MhmSkAPRQK-47AquMJ30-366">
